# Настройки агента. Скопируйте этот файл в .env и заполните значения.
# Файл .env никому не пересылайте — в нём ключи доступа.

# --- Claude (console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=

# --- Телеграм-бот (ключ выдаёт @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Ваш личный номер чата. Узнать: написать боту /start — он ответит номером.
TELEGRAM_CHAT_ID=

# --- Почта для полного отчёта ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
# Пароль приложения (не основной пароль от почты)
SMTP_PASSWORD=
REPORT_EMAIL_TO=

# --- Расписание ---
REPORT_TIME=08:00
# Дни отчёта: 0=пн 1=вт 2=ср 3=чт 4=пт 5=сб 6=вс
REPORT_DAYS=0,4
TIMEZONE=Asia/Novokuznetsk

# --- Название компании для отчёта ---
COMPANY_NAME=Управляющая компания

# --- Голос: ru-RU-DmitryNeural (мужской) или ru-RU-SvetlanaNeural (женский) ---
VOICE=ru-RU-DmitryNeural

# --- Стоимость (замеры — в ИНСТРУКЦИЯ.md, раздел «Сколько это стоит») ---
# Модель для ответов на вопросы: claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-5-5
QA_MODEL=claude-opus-5-5
# Контекст вопроса: report — только полный отчёт (дешевле), full — отчёт + вся сводка
QA_CONTEXT=report
# Кэш отчёта для вопросов: 1h или 5m
QA_CACHE_TTL=1h
# Глубина анализа при сборке отчёта: high или medium (дешевле на ~треть)
REPORT_EFFORT=high
